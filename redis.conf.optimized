# Redis configuration optimized for high-frequency trading
# Generated by Pacifica Bot Redis Optimizer

# Memory settings for trading bot
maxmemory 512mb
maxmemory-policy volatile-lru

# Performance settings
tcp-keepalive 60
timeout 300
tcp-keepalive 60

# Disable RDB snapshots for pure in-memory performance
save ""

# Logging
loglevel notice
logfile ""

# Network
bind 127.0.0.1
port 6379
