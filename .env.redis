# ============================================================================
# 🚀 REDIS GRID BOT - HIGH-PERFORMANCE CONFIGURATION
# ============================================================================
# Optimized configuration for Redis-based grid trading bot
# Focus: Maximum speed, minimum latency, real-time performance
# ============================================================================

# ============ REDIS OPTIMIZATION SETTINGS ============
# Ultra-low latency configuration for high-frequency trading

# Redis connection optimization
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Connection pooling for maximum throughput
REDIS_CONNECTION_POOL_SIZE=20
REDIS_CONNECTION_TIMEOUT=2
REDIS_RETRY_ON_TIMEOUT=true

# Socket optimization for speed
REDIS_SOCKET_KEEPALIVE=true
REDIS_SOCKET_KEEPALIVE_OPTIONS=1,3,5

# ============ CACHE TTL SETTINGS (ULTRA-SHORT) ============
# Minimal TTL for maximum freshness and speed

REDIS_CACHE_TTL_PRICES=5          # 5 seconds for price data (ultra-fresh)
REDIS_CACHE_TTL_POSITIONS=10      # 10 seconds for positions
REDIS_CACHE_TTL_BALANCE=15        # 15 seconds for balance
REDIS_CACHE_TTL_SESSION=3600      # 1 hour for session data

# ============ BOT PERFORMANCE SETTINGS ============
# Optimized for high-frequency operation with Redis backend

# Ultra-fast rebalancing for grid strategies
REBALANCE_INTERVAL_SECONDS=30     # 30 seconds (faster than standard 60)

# Aggressive balance checking for real-time risk management
CHECK_BALANCE_BEFORE_ORDER=true

# Maximum orders for high-frequency trading
MAX_OPEN_ORDERS=50               # Increased for higher frequency

# Session control with tighter limits for faster response
SESSION_STOP_LOSS_USD=50         # Tighter stop loss
SESSION_TAKE_PROFIT_USD=100      # Tighter take profit
SESSION_MAX_LOSS_USD=75          # Tighter max loss

# ============ REDIS STATE MANAGEMENT ============
# Session-based state storage for isolation and performance

# Session identification for multi-bot scenarios
BOT_SESSION_ID=redis_grid_session

# State persistence settings
REDIS_STATE_TTL=7200             # 2 hours state retention
REDIS_CLEANUP_INTERVAL=300       # 5 minute cleanup cycle

# ============ LOGGING OPTIMIZATION ============
# Minimal logging for maximum performance

LOG_LEVEL=WARNING                 # Reduced logging for speed
LOG_TO_REDIS=true               # Optional: log to Redis for debugging

# Disable file logging for speed (console only)
LOG_TO_FILE=false

# ============ PERFORMANCE MONITORING ============
# Real-time performance tracking in Redis

ENABLE_PERFORMANCE_TRACKING=true
PERFORMANCE_UPDATE_INTERVAL=10   # Every 10 iterations

# Redis keys for performance metrics
PERFORMANCE_METRICS_KEY=bot_performance

# ============ RISK MANAGEMENT ============
# Optimized for speed with Redis-backed calculations

# Faster risk checks
RISK_CHECK_INTERVAL=5            # Every 5 iterations

# Redis-backed position tracking for speed
REDIS_POSITION_CACHE=true

# ============ STRATEGY SETTINGS ============
# Optimized for Redis backend performance

# Grid strategy settings for speed
GRID_UPDATE_INTERVAL=15          # 15 seconds for grid updates

# Multi-asset settings for Redis optimization
MULTI_ASSET_CACHE_TTL=10         # 10 seconds cache for multi-asset

# ============ MEMORY OPTIMIZATION ============
# Redis memory usage optimization

# Key prefix for this bot instance
REDIS_KEY_PREFIX=redis_grid

# Automatic cleanup of old data
AUTO_CLEANUP=true
CLEANUP_AGE_MINUTES=60           # Clean data older than 1 hour

# Memory limits
MAX_MEMORY_MB=100               # Maximum Redis memory usage for this bot

# ============ ERROR HANDLING ============
# Fast failure recovery

MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=100              # 100ms retry delay for speed

# Circuit breaker for failed operations
CIRCUIT_BREAKER_THRESHOLD=5     # Break after 5 failures
CIRCUIT_BREAKER_TIMEOUT=30      # 30 second timeout

# ============ NETWORK OPTIMIZATION ============
# Network settings for minimal latency

# API request optimization
API_REQUEST_TIMEOUT=5           # 5 second timeout
API_RETRY_ATTEMPTS=2           # Minimal retries

# WebSocket settings for real-time data
WS_RECONNECT_INTERVAL=5        # Fast reconnection
WS_HEARTBEAT_INTERVAL=10       # Frequent heartbeat

# ============ DEVELOPMENT SETTINGS ============
# Debug settings for development

DEBUG_MODE=false                # Production mode for speed
DEBUG_REDIS_COMMANDS=false     # Disable Redis command logging

# Profiling for performance analysis
ENABLE_PROFILING=false         # Disable for production speed

# ============================================================================
# ⚠️  PERFORMANCE NOTES:
# - All TTL values are minimized for maximum freshness
# - Connection pooling maximized for throughput
# - Logging minimized for speed
# - Error handling optimized for fast recovery
# - Network timeouts reduced for responsiveness
# ============================================================================

# ============================================================================
# 🚀 QUICK START:
# 1. Start Redis server: redis-server
# 2. Run bot: python grid_bot_redis.py
# 3. Monitor: Check Redis for real-time state
# ============================================================================