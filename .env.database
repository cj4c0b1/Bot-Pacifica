# ============================================================================
# 🗄️ DATABASE CONFIGURATION - SQLite & Redis Setup
# ============================================================================
# Configurações para implementação do tech stack de banco de dados
# Conforme especificado no desenvolvimento principles do projeto
# ============================================================================

# ============ SQLITE DATABASE ============
# Arquivo do banco de dados SQLite para desenvolvimento local
SQLITE_DATABASE_PATH=data/pacifica_bot.db

# Pool de conexões SQLite (para evitar conflitos de thread)
SQLITE_POOL_SIZE=5
SQLITE_CHECK_SAME_THREAD=false

# Backup automático do banco SQLite
SQLITE_BACKUP_ENABLED=true
SQLITE_BACKUP_INTERVAL_HOURS=24
SQLITE_BACKUP_RETENTION_DAYS=7

# ============ REDIS CONFIGURATION ============
# Redis para cache e dados em tempo real
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Configurações de conexão Redis
REDIS_CONNECTION_POOL_SIZE=10
REDIS_CONNECTION_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true

# Cache TTL (Time To Live) em segundos
REDIS_CACHE_TTL_PRICES=300        # 5 minutos para preços
REDIS_CACHE_TTL_POSITIONS=60      # 1 minuto para posições
REDIS_CACHE_TTL_BALANCE=30        # 30 segundos para saldo
REDIS_CACHE_TTL_SESSION=3600      # 1 hora para sessão

# ============ DATABASE FEATURES ============
# Recursos específicos para trading bot
ENABLE_PERSISTENT_LOGGING=true    # Logs permanentes no banco
ENABLE_TRADE_ARCHIVE=true         # Arquivamento automático de trades antigos
ENABLE_PERFORMANCE_BACKUP=true    # Backup de métricas de performance

# Limites de armazenamento
MAX_TRADES_HISTORY=50000          # Máximo de trades no banco
MAX_LOGS_DAYS=30                  # Dias de retenção de logs
MAX_PERFORMANCE_RECORDS=10000     # Registros de performance

# ============ MIGRATION SETTINGS ============
# Controle de versões do schema do banco
DATABASE_VERSION=1.0
AUTO_MIGRATE=true
MIGRATION_PATH=src/migrations/

# ============================================================================
# ⚠️  AVISOS IMPORTANTES:
# - Nunca commite arquivos .db em produção
# - Configure Redis com senha em produção
# - Faça backups regulares do banco SQLite
# - Monitore o tamanho do banco de dados
# ============================================================================